{
  "framework": "nextjs",
  "buildCommand": "NODE_ENV=production NEXT_PUBLIC_IS_DOCS=true npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "functions": {
    "app/**": {
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_IS_DOCS": "true"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NEXT_PUBLIC_IS_DOCS": "true"
    }
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next"
      }
    }
  ]
} 