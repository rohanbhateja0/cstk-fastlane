ur_Solutions.png","url":"https://images.contentstack.io/v3/assets/blt33c1b1e577f25486/blt69d2934f7fc83a09/6893d0795384f39d388fabb9/Our_Solutions.png","ACL":[],"is_dir":false,"parent_uid":"blt30ea71c244031fa4","_version":1,"title":"Our Solutions.png","publish_details":[{"environment":"blt3a0dc2829f229753","locale":"en-us","time":"2025-08-06T22:01:23.070Z","user":"csf646828cb4137687","version":1}]},"background_image":null},"_metadata":{"uid":"csc5b825c309914cdf"},"call_to_action":{"link":{"title":"Learn More","href":"/Soluitons"},"secondary_link":{"title":"","href":""}},"rendering_options":{"header_tag":"H2","image_order":"left","card_orientation":"Horizontal Flex"}}}]},"display_options":{"full_width":true,"add_margins":true,"add_top_margin":false,"add_bottom_margin":false,"centered":false,"bordered":false,"background_color":null,"background_image":null}},{"column_settings":{"large_device_columns":"1","medium_device_columns":"1","small_device_columns":"1"},"_metadata":{"uid":"cs641ed7299a574949"},"components":{"components":[{"content_section":{"content":{"title":"A little about us","category":"","intro_text":"<p>From its origins in the aftermath of World War I to its role in shaping global health policy in the 21st century, the International Collegium of Medical Professionals has remained steadfast in its commitment to uniting physicians in the pursuit of ethical, evidence-based care. It has served as a forum for difficult conversations, a repository of shared knowledge, and a bulwark against the politicization of science.</p>","image":{"uid":"blt50034c759da23fdc","created_at":"2025-08-06T22:08:21.701Z","updated_at":"2025-08-06T22:08:21.701Z","created_by":"csf646828cb4137687","updated_by":"csf646828cb4137687","content_type":"image/png","file_size":"635050","tags":[],"filename":"about_us.png","url":"https://images.contentstack.io/v3/assets/blt33c1b1e577f25486/blt50034c759da23fdc/6893d2551826c33ef82b0a73/about_us.png","ACL":[],"is_dir":false,"parent_uid":"blt30ea71c244031fa4","_version":1,"title":"about us.png","publish_details":[{"environment":"blt3a0dc2829f229753","locale":"en-us","time":"2025-08-06T22:09:14.067Z","user":"csf646828cb4137687","version":1}]},"background_image":null},"_metadata":{"uid":"csc1462626b12f5e7f"},"call_to_action":{"link":{"title":"Learn Our History","href":"/History"},"secondary_link":{"title":"See Our Leadership","href":"/Leadership"}},"rendering_options":{"header_tag":"H2","image_order":"right","card_orientation":"Horizontal Flex"}}}]},"display_options":{"full_width":true,"add_margins":true,"add_top_margin":false,"add_bottom_margin":false,"centered":false,"bordered":false,"background_color":"Tertiary","background_image":null}},{"column_settings":{"large_device_columns":"1","medium_device_columns":"1","small_device_columns":"1"},"_metadata":{"uid":"cs5c413efb5efbc9fc"},"components":{"components":[{"content_section":{"content":{"title":"Resources for healthcare advocates","category":"","intro_text":"<p>ICMP’s resources are designed to equip healthcare leaders with the knowledge, tools, and frameworks needed to drive transformation with confidence. From strategic playbooks and implementation toolkits to policy briefs and case studies, our content distills complex challenges into practical, evidence-based solutions.<br />These resources are tailored for decision-makers navigating change—helping them accelerate innovation, reduce risk, and align care models with emerging demands.</p>","image":{"uid":"blt05dd86ccc82430f0","created_at":"2025-08-06T22:11:02.440Z","updated_at":"2025-08-06T22:11:02.440Z","created_by":"csf646828cb4137687","updated_by":"csf646828cb4137687","content_type":"image/png","file_size":"319534","tags":[],"filename":"Resources.png","url":"https://images.contentstack.io/v3/assets/blt33c1b1e577f25486/blt05dd86ccc82430f0/6893d2f6874a9d1a78eb52e5/Resources.png","ACL":[],"is_dir":false,"parent_uid":"blt30ea71c244031fa4","_version":1,"title":"Resources.png","publish_details":[{"environment":"blt