{
  "name": "contentstack-fast-lane-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    ".",
    "docs"
  ],
  "scripts": {
    "build:main": "npm run build",
    "build:docs": "cd docs && npm run build",
    "build:all": "npm run build:main && npm run build:docs",
    "dev:main": "npm run dev",
    "dev:docs": "cd docs && npm run dev",
    "install:all": "npm install && cd docs && npm install"
  }
}
